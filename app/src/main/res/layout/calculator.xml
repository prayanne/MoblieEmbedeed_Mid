<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
<!--        <com.google.android.material.button.MaterialButton-->
<!--            android:layout_width="24dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_marginRight="20dp"-->
<!--            android:padding="0dp"-->
<!--            android:backgroundTint="#00000000"-->
<!--            android:layout_gravity="end"-->
<!--            app:icon="@drawable/baseline_access_time_48"-->
<!--            app:iconSize="22dp"-->
<!--            app:iconGravity="end"-->
<!--            app:iconTint="@color/black"-->
<!--            android:id="@+id/btnHistory"/>-->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="25dp"
            android:paddingRight="20dp"
            android:gravity="end"
            android:textColor="#D0D0D0"
            android:id="@+id/valueCalc"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="50sp"
            android:textStyle="bold"
            android:text="0"
            android:paddingRight="20dp"
            android:gravity="end"
            android:id="@+id/valueView"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:paddingRight="20dp"
            android:gravity="end"
            android:id="@+id/memtext"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/calcMC" android:text="MC" style="@style/btn_NnumM"/>
        <Button android:id="@+id/calcMR" android:text="MR" style="@style/btn_NnumM"/>
        <Button android:id="@+id/calcMP" android:text="MP" android:tag="+" style="@style/btn_NnumM"/>
        <Button android:id="@+id/calcMM" android:text="MM" android:tag="-" style="@style/btn_NnumM"/>
        <Button android:id="@+id/calcMS" android:text="MS" style="@style/btn_NnumM"/>
        <Button android:id="@+id/calcMMore" android:text="M" style="@style/btn_NnumM"/>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:padding="3dp"
        android:rowCount="6"
        android:columnCount="4">

        <Button
            android:id="@+id/calcL"
            android:text="%"
            android:tag="%"
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcCE"
            android:text="CE"
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcC"
            android:text="C"
            style="@style/btn_Nnum"/>
        <com.google.android.material.button.MaterialButton
            android:gravity="center"
            android:id="@+id/calcB"
            app:icon="@drawable/baseline_backspace_48"
            app:iconPadding="-2dp"
            app:iconTint="#E0000000"
            app:iconSize="20dp"
            app:iconGravity="textStart"
            android:textColor="@color/black"
            style="@style/btn_Nnum"/>


        <Button
            android:id="@+id/calc1px"
            android:text="1/x"
            android:tag="1/"
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcX2"
            android:text="x²"
            android:tag="sqr"
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcRoot"
            android:text="√x"
            android:tag="√"
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcD"
            android:text="/"
            android:tag="/"
            style="@style/btn_Nnum"/>


        <Button android:id="@+id/calc7" android:text="7" android:tag="7" style="@style/btn_num"/>
        <Button android:id="@+id/calc8" android:text="8" android:tag="8" style="@style/btn_num"/>
        <Button android:id="@+id/calc9" android:text="9" android:tag="9" style="@style/btn_num"/>

        <Button
            android:id="@+id/calcX"
            android:text="X"
            android:tag="x"
            style="@style/btn_Nnum"/>

        <Button android:id="@+id/calc4" android:text="4" android:tag="4" style="@style/btn_num"/>
        <Button android:id="@+id/calc5" android:text="5" android:tag="5" style="@style/btn_num"/>
        <Button android:id="@+id/calc6" android:text="6" android:tag="6" style="@style/btn_num"/>

        <Button
            android:id="@+id/calcM"
            android:text="-"
            android:tag="-"
            style="@style/btn_Nnum"/>

        <Button android:id="@+id/calc1" android:text="1" android:tag="1" style="@style/btn_num"/>
        <Button android:id="@+id/calc2" android:text="2" android:tag="2" style="@style/btn_num"/>
        <Button android:id="@+id/calc3" android:text="3" android:tag="3" style="@style/btn_num"/>

        <Button
            android:id="@+id/calcP"
            android:text="+"
            android:tag="+"
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcPM"
            android:text="+/-"
            style="@style/btn_Nnum"/>

        <Button android:id="@+id/calc0" android:text="0" android:tag="0" style="@style/btn_num"/>

        <Button
            android:id="@+id/calcDot"
            android:text="."
            style="@style/btn_Nnum"/>
        <Button
            android:id="@+id/calcE"
            android:text="="
            style="@style/btn_NnumE"/>

    </GridLayout>
</LinearLayout>